{
  "name": "@harnessix/paddock-tui",
  "version": "0.2.1",
  "description": "A terminal interface for paddock: runs, approvals, mail and the board, with the keyboard or the mouse",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/harnessix/paddock",
    "directory": "tui"
  },
  "type": "module",
  "bin": {
    "paddock-tui": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "npm run build && vitest run",
    "compile": "node scripts/compile.mjs",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "ink": "7.1.1",
    "react": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@xterm/headless": "6.0.0",
    "eslint": "9.39.5",
    "globals": "17.14.0",
    "ink-testing-library": "4.0.0",
    "node-pty": "1.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.8"
    }
  }
}
