#!/bin/sh
set -eu
if [ "${1:-}" = "--version" ]; then
    echo 'dsh 0.2.1-rc.5'
    exit 0
fi
[ "$1" = --profile ] && [ "$2" = sdk ]
IFS= read -r request
id=$(printf '%s' "$request" | sed -n 's/.*"id":\([0-9][0-9]*\).*/\1/p')
printf '{"jsonrpc":"2.0","id":%s,"result":{"serverInfo":{"name":"fake","version":"1"}}}\n' "$id"
paddock-host horse sessions > sessions.txt
sid=$(cat sessions.txt)
test -n "$sid"
native=$(sed -n 's/.*"native_id":"\([^"]*\)".*/\1/p' "/dev/paddock/horse/self/sessions/$sid/binding")
test -n "$native"
printf '{"jsonrpc":"2.0","method":"session.event","params":{"sessionId":"%s","event":{"type":"user/message","seq":0,"time":1793000000200,"data":{"content":[{"type":"text","text":"horse test"}],"source":{"kind":"user"},"role":"user","id":"m1"},"surfaceOp":"append"}}}\n' "$native"
i=0
while [ "$i" -lt 100 ]; do
    cat "/dev/paddock/horse/self/sessions/$sid/log" > device-log.txt
    if [ -s device-log.txt ]; then break; fi
    i=$((i + 1))
    sleep 0.05
done
test -s device-log.txt
paddock-host horse log "$sid" > broker-log.txt
