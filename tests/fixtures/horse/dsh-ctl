#!/bin/sh
# A fake `dsh --profile sdk` that forks its own session through
# /dev/paddock/horse/self/ctl: once before the host grants ctl, once after.
set -eu
# The test reads the error text of the shell: keep it out of the user's
# language.
export LC_ALL=C
if [ "${1:-}" = "--version" ]; then
    echo 'dsh 0.2.1-rc.5'
    exit 0
fi
[ "$1" = --profile ] && [ "$2" = sdk ]
IFS= read -r request
id=$(printf '%s' "$request" | sed -n 's/.*"id":\([0-9][0-9]*\).*/\1/p')
printf '{"jsonrpc":"2.0","id":%s,"result":{"serverInfo":{"name":"fake","version":"1"}}}\n' "$id"
dev=${FAKE_HORSE_DEV:-/dev/paddock/horse}
paddock-host horse sessions > sessions.tmp
sid=$(cat sessions.tmp)
test -n "$sid"
native=$(paddock-host peek binding | sed -n 's/.*"native_id":"\([^"]*\)".*/\1/p')
test -n "$native"
printf '{"jsonrpc":"2.0","method":"session.event","params":{"sessionId":"%s","event":{"type":"user/message","seq":0,"time":1793000000200,"data":{"content":[{"type":"text","text":"horse test"}],"source":{"kind":"user"},"role":"user","id":"m1"},"surfaceOp":"append"}}}\n' "$native"
printf '{"jsonrpc":"2.0","method":"session.status","params":{"sessionId":"%s","status":"idle"}}\n' "$native"
ctl=$dev/self/ctl
# Without a grant the write fails.
if printf 'fork %s\n' "$sid" 2> ungranted-error.txt > "$ctl"; then
    echo written > ungranted.txt
else
    echo refused > ungranted.txt
    # The answer of the device says why.
    cat "$ctl" > ungranted-answer.txt 2>&1 || true
fi
# The host test waits for this file, then grants.
mv sessions.tmp sessions.txt
n=0
while [ ! -e granted ] && [ "$n" -lt 300 ]; do
    sleep 0.1
    n=$((n + 1))
done
if ! printf 'fork %s\n' "$sid" 2> granted-error.txt > "$ctl"; then
    cat "$ctl" > granted-answer.txt 2>&1 || true
    exit 1
fi
cat "$ctl" > forked.txt
