#!/bin/sh
# A fake `dsh --profile sdk` that edits its horse's DNA and records the
# prompts that paddock delivers at each idle.
set -eu
if [ "${1:-}" = "--version" ]; then
    echo 'dsh 0.2.1-rc.5'
    exit 0
fi
[ "$1" = --profile ] && [ "$2" = sdk ]
IFS= read -r request
id=$(printf '%s' "$request" | sed -n 's/.*"id":\([0-9][0-9]*\).*/\1/p')
printf '{"jsonrpc":"2.0","id":%s,"result":{"serverInfo":{"name":"fake","version":"1"}}}\n' "$id"
paddock-host horse sessions > sessions.txt
sid=$(cat sessions.txt)
test -n "$sid"
# When the device has no binding, show what it has: the test fails below.
native=$(paddock-host peek binding | sed -n 's/.*"native_id":"\([^"]*\)".*/\1/p')
test -n "$native"
printf '[traits]\nstyle = "careful-e2e"\n' | paddock-host horse dna put
paddock-host peek dna | grep -q careful-e2e
idle() {
    printf '{"jsonrpc":"2.0","method":"session.status","params":{"sessionId":"%s","status":"idle"}}\n' "$native"
}
printf '{"jsonrpc":"2.0","method":"session.event","params":{"sessionId":"%s","event":{"type":"user/message","seq":0,"time":1793000000200,"data":{"content":[{"type":"text","text":"horse test"}],"source":{"kind":"user"},"role":"user","id":"m1"},"surfaceOp":"append"}}}\n' "$native"
idle
: > prompts.txt
n=0
while IFS= read -r line; do
    printf '%s\n' "$line" >> prompts.txt
    case "$line" in
    *'"session/prompt"'*)
        n=$((n + 1))
        pid=$(printf '%s' "$line" | sed -n 's/.*"id":\([0-9][0-9]*\).*/\1/p')
        printf '{"jsonrpc":"2.0","id":%s,"result":{"messageId":"m-%s"}}\n' "$pid" "$n"
        idle
        ;;
    esac
    if grep -q careful-e2e prompts.txt; then
        break
    fi
done
