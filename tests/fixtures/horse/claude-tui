#!/bin/bash
# fake-claude-tui: a fake interactive Claude Code 2.1.317. It contacts
# nothing.
#
# `--version` prints the version. With `--channels=server:paddock` (horse
# mode on a version with a channel) it does what Claude Code does with
# that command line: it runs the Stop and UserPromptSubmit hooks of its
# --settings, starts the MCP server of its --mcp-config and reads the
# channel notifications. Turn 1 is "hi". Each notification becomes the
# user row of the next turn. Without the channel it writes turn 1 only.
#
# It ends when the file `done` appears in its working folder (the
# project), or after 120 seconds.
set -u
version=2.1.317
if [ "${1:-}" = "--version" ]; then
    echo "$version (Claude Code)"
    exit 0
fi
native= settings= mcp= channel=
while [ $# -gt 0 ]; do
    case "$1" in
    --session-id=*) native=${1#--session-id=} ;;
    --settings) settings=$2; shift ;;
    --mcp-config=*) mcp=${1#--mcp-config=} ;;
    --channels=server:paddock) channel=1 ;;
    esac
    shift
done
test -n "$native" || native=01934b20-1111-7777-8888-123456789abc
dir="$HOME/.claude/projects/$(printf '%s' "$PWD" | sed 's/[^A-Za-z0-9]/-/g')"
mkdir -p "$dir"
file="$dir/$native.jsonl"
parent=
row() {
    if [ -n "$parent" ]; then p="\"$parent\""; else p=null; fi
    printf '{"parentUuid":%s,"isSidechain":false,"type":"%s","message":%s,"uuid":"%s","timestamp":"2026-11-06T10:00:00.000Z","userType":"external","entrypoint":"cli","cwd":"%s","sessionId":"%s","version":"%s","gitBranch":"main"}\n' \
        "$p" "$1" "$2" "$3" "$PWD" "$native" "$version" >> "$file"
    parent=$3
}
# The command of the horse hook of an event, as the --settings JSON holds
# it: Stop says stop, UserPromptSubmit says prompt.
hook() {
    case "$1" in Stop) kind=stop ;; UserPromptSubmit) kind=prompt ;; esac
    cmd=$(printf '%s' "$settings" | grep -o "\"command\":\"paddock-host horse safe-point $kind[^\"]*\"" | sed 's/^"command":"//; s/"$//')
    test -n "$cmd" || exit 31
    echo '{}' | sh -c "$cmd" || exit 32
}
turn() {
    n=$1 text=$2
    [ -n "$channel" ] && hook UserPromptSubmit
    row user "{\"role\":\"user\",\"content\":[{\"type\":\"text\",\"text\":\"$text\"}]}" "u$n"
    row assistant "{\"id\":\"msg_$n\",\"type\":\"message\",\"role\":\"assistant\",\"model\":\"claude-opus-5-5\",\"content\":[{\"type\":\"text\",\"text\":\"turn $n done\"}],\"stop_reason\":\"end_turn\",\"usage\":{\"input_tokens\":4,\"cache_creation_input_tokens\":0,\"cache_read_input_tokens\":0,\"output_tokens\":2}}" "a$n"
    [ -n "$channel" ] && hook Stop
}
if [ -z "$channel" ]; then
    turn 1 hi
    for _ in $(seq 1200); do [ -e done ] && exit 0; sleep 0.1; done
    exit 0
fi
printf '%s' "$mcp" | grep -q '"paddock":{[^}]*"command":"paddock-host"' || exit 33
coproc CH { paddock-host channel; }
echo '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-11-25","capabilities":{},"clientInfo":{"name":"fake-claude-tui"}}}' >&"${CH[1]}"
read -r -t 30 reply <&"${CH[0]}" || exit 34
case "$reply" in *'"claude/channel"'*) ;; *) exit 35 ;; esac
echo '{"jsonrpc":"2.0","method":"notifications/initialized"}' >&"${CH[1]}"
turn 1 hi
n=1
while [ ! -e done ]; do
    if read -r -t 1 push <&"${CH[0]}"; then
        id=$(printf '%s' "$push" | grep -o '"entry_id":"[^"]*"' | sed 's/^"entry_id":"//; s/"$//')
        test -n "$id" || exit 36
        n=$((n + 1))
        turn "$n" "<channel source=\\\"paddock\\\" entry_id=\\\"$id\\\">queued</channel>"
    fi
done
exit 0
