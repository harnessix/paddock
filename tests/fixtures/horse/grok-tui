#!/bin/bash
# fake-grok-tui: a fake interactive Grok Build 1.0.70. It contacts nothing.
#
# `--version` prints the version. Else it is a TUI on its terminal: it
# shows the turn status row (a spinner and "[stop]") while it "thinks",
# writes the rows of the turn to its session folder, and then shows the
# empty composer row "❯". At the start and the end of each turn it runs
# the hooks of ~/.grok/hooks/*.json that call `safe-point prompt` and
# `safe-point stop` (UserPromptSubmit and Stop), with the JSON event of
# Grok on stdin (sessionId, promptId). Turn 1 is "hi" and thinks for 3 s;
# each line that comes on the terminal is the prompt of the next turn,
# which thinks for 1 s. Each event goes into the file `tui.log` of its
# working folder (the project).
#
# It ends when the file `done` appears in its working folder, or after
# 120 seconds.
set -u
version=1.0.70
if [ "${1:-}" = "--version" ]; then
    echo "grok $version"
    exit 0
fi
id=019a5f00-2222-7000-8000-00000000c0de
# The folder name of the working directory: Grok's URL encoding.
enc=""
for ((i = 0; i < ${#PWD}; i++)); do
    c=${PWD:i:1}
    case "$c" in
    [A-Za-z0-9._~-]) enc+="$c" ;;
    *) enc+=$(printf '%%%02X' "'$c") ;;
    esac
done
dir="$HOME/.grok/sessions/$enc/$id"
mkdir -p "$dir"
updates="$dir/updates.jsonl"
chat="$dir/chat_history.jsonl"
log="$PWD/tui.log"
: > "$log"
: > "$updates"
printf '{"type":"system","content":"You are Grok."}\n' > "$chat"
stty -echo 2>/dev/null
event=0
json() {
    printf '%s\n' "$1" | awk 'BEGIN { ORS = "" } {
        gsub(/\\/, "\\\\"); gsub(/"/, "\\\""); gsub(/\t/, "\\t")
        if (NR > 1) print "\\n"
        print
    }'
}
summary() {
    printf '{"info":{"id":"%s","cwd":"%s"},"session_kind":"interactive","num_messages":%s,"chat_format_version":1}\n' \
        "$id" "$PWD" "$event" > "$dir/summary.json"
}
update() {
    event=$((event + 1))
    printf '{"timestamp":%s,"method":"%s","params":{"sessionId":"%s","update":%s,"_meta":{"eventId":"%s-%s"}}}\n' \
        "$((1793750400 + event))" "$1" "$id" "$2" "$id" "$event" >> "$updates"
}
# Run the hook commands of the TUI that call `safe-point KIND`.
hook() {
    local kind=$1 n=$2 cmd
    cmd=$(cat "$HOME"/.grok/hooks/*.json 2>/dev/null |
        grep -o "\"command\": *\"[^\"]*safe-point $kind[^\"]*\"" | head -1 |
        sed 's/^"command": *"//; s/"$//')
    [ -n "$cmd" ] || return 0
    printf '{"hookEventName":"%s","sessionId":"%s","promptId":"p%s","cwd":"%s"}' \
        "$kind" "$id" "$n" "$PWD" | sh -c "$cmd" >/dev/null 2>&1
    echo "hook $kind $n" >> "$log"
}
busy() { printf '\033[2J\033[H\xe2\xa0\x8b Thinking %ss   [stop]\r\n\r\n\xe2\x9d\xaf ' "$1"; }
idle() { printf '\033[2J\033[H\xe2\x9d\xaf \r\n\r\n  grok-build'; }
turn() {
    n=$1 text=$(json "$2") think=$3
    p=$((n - 1))
    hook prompt "$n"
    busy 0
    update session/update "{\"sessionUpdate\":\"user_message_chunk\",\"content\":{\"type\":\"text\",\"text\":\"$text\"},\"_meta\":{\"promptIndex\":$p}}"
    printf '{"type":"user","content":[{"type":"text","text":"%s"}],"prompt_index":%s}\n' "$text" "$p" >> "$chat"
    summary
    for s in $(seq "$think"); do sleep 1; busy "$s"; done
    update session/update "{\"sessionUpdate\":\"agent_message_chunk\",\"content\":{\"type\":\"text\",\"text\":\"turn $n done\"}}"
    update _x.ai/session/update "{\"sessionUpdate\":\"turn_completed\",\"stopReason\":\"end_turn\"}"
    printf '{"type":"assistant","content":"turn %s done","model_id":"grok-build"}\n' "$n" >> "$chat"
    summary
    echo "end $n" >> "$log"
    hook stop "$n"
    idle
}
# Wait up to $1 seconds for a whole line, into `got`. A read that times
# out in the middle of a line keeps what it read (bash 4.4 and later), and
# the next call goes on from there: no byte of a typed line is lost.
pending=""
poll() {
    local part=""
    if IFS= read -r -t "$1" part; then
        got="$pending$part"
        pending=""
        return 0
    fi
    pending="$pending$part"
    return 1
}
turn 1 hi 3
n=1
for _ in $(seq 120); do
    [ -e done ] && exit 0
    if poll 1; then
        # A bracketed paste is one input, also over more than one line.
        case "$got" in
        $'\e[200~'*)
            first=$got
            while [[ "$first" != *$'\e[201~'* ]]; do
                poll 5 || break
                first="$first"$'\n'"$got"
            done
            got=$first
            got=${got#$'\e[200~'}
            got=${got%$'\e[201~'*}
            ;;
        esac
        n=$((n + 1))
        echo "got $n $got" >> "$log"
        turn "$n" "$got" 1
    fi
done
exit 0
